# Servidor
PORT=3000
NODE_ENV=development
APP_NAME=UFS DRIVE
APP_TAGLINE=Seus arquivos no provedor — e nas portas que você conectar.

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ufsdrive
DB_PASSWORD=sua_senha_mysql
DB_NAME=ufsdrive
# DB_POOL_SIZE=10

# Armazenamento principal: disk (padrão) ou r2
STORAGE=disk
STORAGE_DIR=/var/ufs-drive/files
UPLOAD_SECRET=troque_por_um_valor_aleatorio
MAX_UPLOAD_MB=50

# Cloudflare R2 (S3-compatible) — só com STORAGE=r2
# R2_ACCOUNT_ID=seu_account_id
# R2_ACCESS_KEY_ID=sua_access_key
# R2_SECRET_ACCESS_KEY=sua_secret_key
# R2_BUCKET=ufs-drive
# R2_PUBLIC_URL=https://files.seudominio.com
# R2_ENDPOINT=http://localhost:9000
# R2_INTERNAL_ENDPOINT=http://minio:9000
# R2_FORCE_PATH_STYLE=true
# R2_REGION=us-east-1

# Admin (/admin) — pastas, ZIP e portas de sync
ADMIN_PASSWORD=troque_esta_senha

# Portas de sync (Google Drive, Dropbox, S3, webhook) são cadastradas
# em /admin — não precisam de variáveis aqui. Cada upload no disco/R2
# do provedor é espelhado nas portas ativas.
