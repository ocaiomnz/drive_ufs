{
  "name": "ufs-drive",
  "version": "1.0.0",
  "description": "UFS DRIVE — armazenamento de arquivos com sync para Google Drive e serviços semelhantes",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "echo 'Sem etapa de build: o app roda direto com npm start'",
    "docker:up": "npm run build",
    "dev": "node --watch server.js",
    "test:presign": "node scripts/test-presign.js",
    "test:carga": "node scripts/load-test.js",
    "db:init": "node scripts/init-db.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "archiver": "^7.0.1",
    "compression": "^1.8.2",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "mysql2": "^3.11.4",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "autocannon": "^8.0.0"
  }
}
